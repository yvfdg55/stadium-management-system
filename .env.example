SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters
DATABASE_PATH=instance/stadium.db
PORT=5000
HOST=127.0.0.1
TRUSTED_HOSTS=localhost,127.0.0.1
TRUSTED_PROXY_HOPS=0
SESSION_COOKIE_SECURE=true
APP_UTC_OFFSET_HOURS=3
# Initial default only; after database setup, change the rate in /admin/settings.
HOURLY_RATE=10000
